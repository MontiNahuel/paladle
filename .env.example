# Base de datos Neon (PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/paladle?sslmode=require"

# Control del panel de administración (true en rama dev / local, false en main / prod)
ENABLE_ADMIN_PANEL="true"
ADMIN_PASSWORD="cambia-esta-clave-segura"
ADMIN_SESSION_SECRET="cambia-este-secreto-largo-para-firmar-cookies"

# Vercel Blob (subida dinámica de avatares y fondos desde /admin)
BLOB_READ_WRITE_TOKEN=""
